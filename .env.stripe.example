# ============================================================================
# Stripe Payment Gateway Configuration
# ============================================================================
#
# This section contains all environment variables needed for Stripe
# payment gateway integration. Get these values from:
# https://dashboard.stripe.com/developers/api_keys
#
# IMPORTANT: Never commit sensitive keys to version control!
# Always use environment variables for production.
#

# ============================================================================
# API Keys
# ============================================================================
# 
# Get these from: Dashboard → Developers → API Keys
#
# Publishable Key: Safe to expose in frontend and mobile apps
STRIPE_PUBLIC_KEY=pk_test_your_publishable_key_here

# Secret Key: Keep private, only use on server
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# ============================================================================
# Webhook Configuration
# ============================================================================
#
# Get this from: Dashboard → Developers → Webhooks
# After creating webhook endpoint pointing to: /api/v1/webhooks/stripe
#
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# Stripe Mode
# ============================================================================
#
# Mode options:
#   test   - Use test API keys (recommended for development)
#   live   - Use live API keys (production only)
#
STRIPE_MODE=test

# ============================================================================
# Currency Configuration
# ============================================================================
#
# ISO 4217 currency code in lowercase
# Examples: usd, eur, gbp, inr, aud, cad, jpy, etc.
#
STRIPE_CURRENCY=usd

# ============================================================================
# API Version
# ============================================================================
#
# Stripe API version to use for requests
# Keep updated to latest stable version for new features
#
STRIPE_API_VERSION=2024-04-10

# ============================================================================
# Statement Descriptor
# ============================================================================
#
# Text that appears on customer's credit card statement
# Maximum 22 characters (including spaces)
# Avoid special characters
#
STRIPE_STATEMENT_DESCRIPTOR=OLX Marketplace

# ============================================================================
# Migration Instructions
# ============================================================================
#
# 1. Copy this file to a new .env file:
#    cp .env.example .env
#
# 2. Get your test keys from Stripe Dashboard:
#    https://dashboard.stripe.com/account/apikeys
#
# 3. Replace the placeholder values with your actual keys
#
# 4. For production, switch to live keys:
#    - Go to Stripe Dashboard (top left corner)
#    - Toggle from "Test" to "Live" mode
#    - Copy live API keys
#    - Update .env with STRIPE_MODE=live and live keys
#
# 5. Test the integration:
#    - Run: php artisan tinker
#    - Type: config('stripe.secret_key')
#    - Verify your key appears correctly
#
# ============================================================================
# Security Best Practices
# ============================================================================
#
# - NEVER commit .env file to version control
# - NEVER share API keys via email or chat
# - NEVER expose secret keys in logs
# - Rotate keys regularly
# - Use different keys for test and live environments
# - Enable IP whitelisting if available
# - Monitor webhook delivery logs regularly
# - Set up Stripe alerts for suspicious activity
#
